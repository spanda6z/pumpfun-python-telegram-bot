# Required
TELEGRAM_BOT_TOKEN=
WALLET_PRIVATE_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Community / space: allow everyone (default true)
PUBLIC_ACCESS=true

# Optional whitelist if PUBLIC_ACCESS=false
TELEGRAM_ALLOWED_USER_IDS=

# Optional admins only for settings + panic (comma-separated Telegram user ids)
TELEGRAM_ADMIN_USER_IDS=

# Trading
PAPER_TRADE=true
BUY_SIZE_SOL=0.5
SLIPPAGE_PCT=15
PRIORITY_FEE_SOL=0.0005

# Optional
BOT_USERNAME=
ACTIVITY_CHANNEL_ID=
BROADCAST_ENABLED=true
